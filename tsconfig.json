{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@bb/plugin-sdk": [
        "./types/bb-plugin-sdk.d.ts"
      ],
      "@bb/plugin-sdk/app": [
        "./types/bb-plugin-sdk-app.d.ts"
      ]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "server.ts",
    "contract.ts",
    "app.tsx",
    "pairing-ui.ts",
    "pairing-ui.test.ts",
    "pairing-status.ts",
    "pairing-status.test.ts",
    "discord.ts",
    "discord.test.ts",
    "bridge.ts",
    "pairing.ts",
    "tools.ts",
    "bridge.test.ts",
    "pairing.test.ts",
    "tools.test.ts",
    "types"
  ]
}
